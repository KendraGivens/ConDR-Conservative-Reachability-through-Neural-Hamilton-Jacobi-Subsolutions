+class Air6DJoint(Dynamics):
+    """Full 6D joint-state two-vehicle collision avoidance.
+
+    The unreduced form of the Air3D game: pursuer and evader Dubins vehicles
+    with joint state [x_p, y_p, th_p, x_e, y_e, th_e]. Evader turn rate is the
+    control (maximizing, avoid), pursuer turn rate is the disturbance.
+    Parameters match the Air3D benchmark: velocity 0.75, |u|,|d| <= omega_max,
+    collision radius collisionR.
+    """
+    def __init__(self, collisionR:float, velocity:float, omega_max:float, angle_alpha_factor:float):
+        self.collisionR = collisionR
+        self.velocity = velocity
+        self.omega_max = omega_max
+        self.angle_alpha_factor = angle_alpha_factor
+        super().__init__(
+            loss_type='brt_hjivi', set_mode='avoid',
+            state_dim=6, input_dim=7, control_dim=1, disturbance_dim=1,
+            state_mean=[0, 0, 0, 0, 0, 0],
+            state_var=[1, 1, self.angle_alpha_factor*math.pi, 1, 1, self.angle_alpha_factor*math.pi],
+            value_mean=0.25,
+            value_var=0.5,
+            value_normto=0.02,
+            deepreach_model="exact",
+        )
+
+    def state_test_range(self):
+        return [
+            [-1, 1],
+            [-1, 1],
+            [-math.pi, math.pi],
+            [-1, 1],
+            [-1, 1],
+            [-math.pi, math.pi],
+        ]
+
+    def equivalent_wrapped_state(self, state):
+        wrapped_state = torch.clone(state)
+        wrapped_state[..., 2] = (wrapped_state[..., 2] + math.pi) % (2*math.pi) - math.pi
+        wrapped_state[..., 5] = (wrapped_state[..., 5] + math.pi) % (2*math.pi) - math.pi
+        return wrapped_state
+
+    # \dot x_p  = v \cos th_p
+    # \dot y_p  = v \sin th_p
+    # \dot th_p = d
+    # \dot x_e  = v \cos th_e
+    # \dot y_e  = v \sin th_e
+    # \dot th_e = u
+    def dsdt(self, state, control, disturbance):
+        dsdt = torch.zeros_like(state)
+        dsdt[..., 0] = self.velocity*torch.cos(state[..., 2])
+        dsdt[..., 1] = self.velocity*torch.sin(state[..., 2])
+        dsdt[..., 2] = disturbance[..., 0]
+        dsdt[..., 3] = self.velocity*torch.cos(state[..., 5])
+        dsdt[..., 4] = self.velocity*torch.sin(state[..., 5])
+        dsdt[..., 5] = control[..., 0]
+        return dsdt
+
+    def boundary_fn(self, state):
+        return torch.norm(state[..., 0:2] - state[..., 3:5], dim=-1) - self.collisionR
+
+    def sample_target_state(self, num_samples):
+        raise NotImplementedError
+
+    def cost_fn(self, state_traj):
+        return torch.min(self.boundary_fn(state_traj), dim=-1).values
+
+    def hamiltonian(self, state, dvds):
+        ham = self.velocity*torch.cos(state[..., 2])*dvds[..., 0] \
+            + self.velocity*torch.sin(state[..., 2])*dvds[..., 1] \
+            + self.velocity*torch.cos(state[..., 5])*dvds[..., 3] \
+            + self.velocity*torch.sin(state[..., 5])*dvds[..., 4]
+        ham = ham + self.omega_max * torch.abs(dvds[..., 5])  # evader control (maximizing)
+        ham = ham - self.omega_max * torch.abs(dvds[..., 2])  # pursuer disturbance (minimizing)
+        return ham
+
+    def optimal_control(self, state, dvds):
+        return (self.omega_max * torch.sign(dvds[..., 5]))[..., None]
+
+    def optimal_disturbance(self, state, dvds):
+        return (-self.omega_max * torch.sign(dvds[..., 2]))[..., None]
+
+    def plot_config(self):
+        return {
+            'state_slices': [0, 0, math.pi/2, 0, 0, 0],
+            'state_labels': ['x_p', 'y_p', 'th_p', 'x_e', 'y_e', 'th_e'],
+            'x_axis_idx': 0,
+            'y_axis_idx': 1,
+            'z_axis_idx': 2,
+        }
+
