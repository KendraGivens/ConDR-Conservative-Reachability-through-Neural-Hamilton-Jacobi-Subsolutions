+class LinearOscillator2D(Dynamics):
+    """Controlled linear oscillator: reach a circle of radius goalR.
+
+    x1' = x2, x2' = -omega^2 x1 + u + d; control minimizes (reach),
+    disturbance maximizes.
+    """
+    def __init__(self, goalR:float, omega:float, u_max:float, d_max:float):
+        self.goalR = goalR
+        self.omega = omega
+        self.u_max = u_max
+        self.d_max = d_max
+        super().__init__(
+            loss_type='brt_hjivi', set_mode='reach',
+            state_dim=2, input_dim=3, control_dim=1, disturbance_dim=1,
+            state_mean=[0, 0],
+            state_var=[1, 1],
+            value_mean=0.25,
+            value_var=0.5,
+            value_normto=0.02,
+            deepreach_model="exact",
+        )
+
+    def state_test_range(self):
+        return [
+            [-1, 1],
+            [-1, 1],
+        ]
+
+    def equivalent_wrapped_state(self, state):
+        return torch.clone(state)
+
+    def dsdt(self, state, control, disturbance):
+        dsdt = torch.zeros_like(state)
+        dsdt[..., 0] = state[..., 1]
+        dsdt[..., 1] = -(self.omega**2)*state[..., 0] + control[..., 0] + disturbance[..., 0]
+        return dsdt
+
+    def boundary_fn(self, state):
+        return torch.norm(state[..., 0:2], dim=-1) - self.goalR
+
+    def sample_target_state(self, num_samples):
+        raise NotImplementedError
+
+    def cost_fn(self, state_traj):
+        return torch.min(self.boundary_fn(state_traj), dim=-1).values
+
+    def hamiltonian(self, state, dvds):
+        ham = state[..., 1]*dvds[..., 0] - (self.omega**2)*state[..., 0]*dvds[..., 1]
+        ham = ham - self.u_max * torch.abs(dvds[..., 1])  # control (minimizing, reach)
+        ham = ham + self.d_max * torch.abs(dvds[..., 1])  # disturbance (maximizing)
+        return ham
+
+    def optimal_control(self, state, dvds):
+        return (-self.u_max * torch.sign(dvds[..., 1]))[..., None]
+
+    def optimal_disturbance(self, state, dvds):
+        return (self.d_max * torch.sign(dvds[..., 1]))[..., None]
+
+    def plot_config(self):
+        return {
+            'state_slices': [0, 0],
+            'state_labels': ['x1', 'x2'],
+            'x_axis_idx': 0,
+            'y_axis_idx': 1,
+            'z_axis_idx': 1,
+        }
