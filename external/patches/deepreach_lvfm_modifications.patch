+def init_brt_hjivi_conservative_loss(dynamics, w_ineq, w_act, dirichlet_loss_divisor):
+    """Conservative (subsolution) HJI-VI loss.
+
+    Splits the VI into its two branches
+        r_pde = dV/dtau - H(x, dV/dx),      r_g = V - g(x)
+    and trains toward a SUBSOLUTION (both <= 0) rather than an exact solution:
+
+        L = w_ineq * E[ relu(r_pde)^2 + relu(r_g)^2 ]     (safety: penalize violations)
+          + w_act  * E[ min(r_pde^2, r_g^2) ]             (tightness: one branch active)
+
+    With deepreach_model='exact_conservative' the r_g branch holds by
+    construction, so the inequality term acts on r_pde. By the comparison
+    principle a subsolution's sub-level set contains the true BRT, i.e. the
+    learned tube over-approximates (errs toward declaring states unsafe).
+    """
+    def brt_hjivi_conservative_loss(state, value, dvdt, dvds, boundary_value, dirichlet_mask, output):
+        if torch.all(dirichlet_mask):
+            # pretraining: match the terminal condition only
+            diff_constraint_hom = torch.Tensor([0])
+            ineq = torch.Tensor([0])
+            act = torch.Tensor([0])
+        else:
+            ham = dynamics.hamiltonian(state, dvds)
+            r_pde = dvdt - ham
+            r_g = value - boundary_value
+            ineq = torch.relu(r_pde).pow(2) + torch.relu(r_g).pow(2)
+            act = torch.minimum(r_pde.pow(2), r_g.pow(2))
+            diff_constraint_hom = w_ineq * ineq + w_act * act
+
+        dirichlet = value[dirichlet_mask] - boundary_value[dirichlet_mask]
+        if dynamics.deepreach_model in ('exact', 'exact_conservative'):
+            if torch.all(dirichlet_mask):
+                dirichlet = output.squeeze(dim=-1)[dirichlet_mask] - 0.0
+            else:
+                return {'diff_constraint_hom': diff_constraint_hom.sum()}
+
+        return {'dirichlet': torch.abs(dirichlet).sum() / dirichlet_loss_divisor,
+                'diff_constraint_hom': diff_constraint_hom.sum()}
+
+    return brt_hjivi_conservative_loss
