+class Air6D(Dynamics):
+    """6D joint two-vehicle Air3D, matching src/lvfm/residuals.py::Air6DJointResidual.
+
+    State s = [x_p, y_p, theta_p, x_e, y_e, theta_e] -- pursuer first, as in our
+    residual. Each vehicle is a Dubins car; the EVADER's turn rate is the control
+    (maximising) and the PURSUER's is the disturbance (minimising), so this is the
+    joint-state form of the Air3D avoid game.
+
+    Deliberately NOT Dubins6D: that class adds a box-containment term to its
+    boundary (min(collision, box)), which our target function does not have, and
+    uses v=0.6, omega=1.9 on a +/-3.5 x +/-2.5 domain. Here the canonical
+    DeepReach Air3D constants are used so the 6D study is the same system as the
+    3D one, lifted.
+    """
+
+    def __init__(self, set_mode: str = "avoid"):
+        self.goalR = 0.25
+        self.evader_velocity = 0.75
+        self.pursuer_velocity = 0.75
+        self.omega_max = 3.0
+        self.state_max = 1.0
+        self.angle_alpha_factor = 1.2
+
+        self.state_range_ = torch.tensor([
+            [-self.state_max, self.state_max],
+            [-self.state_max, self.state_max],
+            [-math.pi, math.pi],
+            [-self.state_max, self.state_max],
+            [-self.state_max, self.state_max],
+            [-math.pi, math.pi],
+        ]).to(device)
+        self.control_range_ = torch.tensor([[-self.omega_max, self.omega_max]]).to(device)
+        self.disturbance_range_ = torch.tensor([[-self.omega_max, self.omega_max]]).to(device)
+        self.control_init = torch.zeros(1).to(device)
+        self.disturbance_init = torch.zeros(1).to(device)
+        self.set_mode = set_mode
+        self.eps_var = torch.tensor([1]).to(device)
+
+        state_mean_ = (self.state_range_[:, 0] + self.state_range_[:, 1]) / 2.0
+        state_var_ = (self.state_range_[:, 1] - self.state_range_[:, 0]) / 2.0
+        state_var_[2] = self.angle_alpha_factor * math.pi
+        state_var_[5] = self.angle_alpha_factor * math.pi
+
+        super().__init__(
+            name="Air6D", loss_type="brt_hjivi", set_mode=set_mode,
+            state_dim=6, input_dim=7, control_dim=1, disturbance_dim=1,
+            state_mean=state_mean_.cpu().tolist(),
+            state_var=state_var_.cpu().tolist(),
+            value_mean=0.25, value_var=0.5, value_normto=0.02,
+            deepReach_model="exact",
+        )
+
+    def control_range(self, state):
+        return self.control_range_.cpu().tolist()
+
+    def disturbance_range(self, state):
+        return self.disturbance_range_.cpu().tolist()
+
+    def clamp_disturbance(self, state, disturbance):
+        return self.bound_disturbance(disturbance)
+
+    def bound_disturbance(self, disturbance):
+        return torch.clamp(disturbance, self.disturbance_range_[..., 0],
+                           self.disturbance_range_[..., 1])
+
+    def clamp_control(self, state, control):
+        return torch.clamp(control, self.control_range_[..., 0], self.control_range_[..., 1])
+
+    def state_test_range(self):
+        return self.state_range_.cpu().tolist()
+
+    def state_verification_range(self):
+        # scenario_optimization() samples through this; without it the recovery /
+        # post-hoc-certification evaluation dies with AttributeError, which is why
+        # every high-dim recovery run produced no basic_logs. Same convention the
+        # shipped classes use: verify over the training range.
+        return self.state_range_.cpu().tolist()
+
+    def equivalent_wrapped_state(self, state):
+        w = torch.clone(state)
+        w[..., 2] = (w[..., 2] + math.pi) % (2 * math.pi) - math.pi
+        w[..., 5] = (w[..., 5] + math.pi) % (2 * math.pi) - math.pi
+        return w
+
+    def periodic_transform_fn(self, input):
+        # Identity: raw headings normalised by alpha*pi, matching our models and
+        # official DeepReach (no sin/cos lift), so input_dim = 1 + 6.
+        return input.to(device)
+
+    def dsdt(self, state, control, disturbance):
+        out = torch.zeros_like(state)
+        th_p, th_e = state[..., 2], state[..., 5]
+        out[..., 0] = self.pursuer_velocity * torch.cos(th_p)
+        out[..., 1] = self.pursuer_velocity * torch.sin(th_p)
+        out[..., 2] = disturbance[..., 0]          # pursuer turn rate = disturbance
+        out[..., 3] = self.evader_velocity * torch.cos(th_e)
+        out[..., 4] = self.evader_velocity * torch.sin(th_e)
+        out[..., 5] = control[..., 0]              # evader turn rate = control
+        return out
+
+    def boundary_fn(self, state):
+        # Collision distance only -- no box term.
+        dx = state[..., 0] - state[..., 3]
+        dy = state[..., 1] - state[..., 4]
+        return torch.sqrt(dx ** 2 + dy ** 2 + 1e-12) - self.goalR
+
+    def cost_fn(self, state_traj):
+        return torch.min(self.boundary_fn(state_traj), dim=-1).values
+
+    def sample_target_state(self, num_samples):
+        raise NotImplementedError
+
+    def hamiltonian(self, state, dvds):
+        th_p, th_e = state[..., 2], state[..., 5]
+        base = (self.pursuer_velocity * torch.cos(th_p) * dvds[..., 0]
+                + self.pursuer_velocity * torch.sin(th_p) * dvds[..., 1]
+                + self.evader_velocity * torch.cos(th_e) * dvds[..., 3]
+                + self.evader_velocity * torch.sin(th_e) * dvds[..., 4])
+        if self.set_mode == "avoid":
+            return (base + self.omega_max * torch.abs(dvds[..., 5])
+                    - self.omega_max * torch.abs(dvds[..., 2]))
+        elif self.set_mode == "reach":
+            return (base - self.omega_max * torch.abs(dvds[..., 5])
+                    + self.omega_max * torch.abs(dvds[..., 2]))
+        raise NotImplementedError
+
+    def optimal_control(self, state, dvds):
+        sgn = 1.0 if self.set_mode == "avoid" else -1.0
+        return (sgn * self.omega_max * torch.sign(dvds[..., 5]))[..., None]
+
+    def optimal_disturbance(self, state, dvds):
+        sgn = -1.0 if self.set_mode == "avoid" else 1.0
+        return (sgn * self.omega_max * torch.sign(dvds[..., 2]))[..., None]
+
+    def plot_config(self):
+        return {"state_slices": [0.0, 0.0, 0.0, 0.5, 0.0, math.pi],
+                "state_labels": ["x_p", "y_p", "th_p", "x_e", "y_e", "th_e"],
+                "x_axis_idx": 3, "y_axis_idx": 4, "z_axis_idx": 5}
+
+
+class MultiVehicle9D(Dynamics):
+    """9D three-vehicle collision avoidance -- DeepReach's published high-dim benchmark.
+
+    Ported VERBATIM from external/deepreach/dynamics/dynamics.py::MultiVehicleCollision
+    so the 9D study is the same system the DeepReach paper reports, not a variant.
+    Constants: v = 0.6, omega_max = 1.1, R = 0.25, domain +/-1, alpha = 1.2.
+
+    State s = [x1, y1, x2, y2, x3, y3, th1, th2, th3]. Three Dubins cars, EACH
+    controlling its own turn rate (control_dim 3, no disturbance), avoiding pairwise
+    collision. boundary_fn = min over all three pairwise distances - R.
+
+    Identity periodic_transform_fn (raw headings / (alpha*pi), no sin-cos lift) so
+    input_dim = 10, matching both official DeepReach and our Air3D/Air6D models.
+    """
+
+    def __init__(self, set_mode: str = "avoid"):
+        self.angle_alpha_factor = 1.2
+        self.velocity = 0.6
+        self.omega_max = 1.1
+        self.collisionR = 0.25
+        self.state_range_ = torch.tensor(
+            [[-1.0, 1.0]] * 6 + [[-math.pi, math.pi]] * 3
+        ).to(device)
+        self.control_range_ = torch.tensor(
+            [[-self.omega_max, self.omega_max]] * 3
+        ).to(device)
+        self.control_init = torch.zeros(3).to(device)
+        self.disturbance_init = torch.zeros(0).to(device)
+        self.eps_var = torch.tensor([1]).to(device)
+        super().__init__(
+            name="MultiVehicle9D", loss_type="brt_hjivi", set_mode=set_mode,
+            state_dim=9, input_dim=10, control_dim=3, disturbance_dim=0,
+            state_mean=[0, 0, 0, 0, 0, 0, 0, 0, 0],
+            state_var=[1, 1, 1, 1, 1, 1,
+                       self.angle_alpha_factor * math.pi,
+                       self.angle_alpha_factor * math.pi,
+                       self.angle_alpha_factor * math.pi],
+            value_mean=0.25, value_var=0.5, value_normto=0.02,
+            deepReach_model="exact",
+        )
+
+    def control_range(self, state):
+        return self.control_range_.cpu().tolist()
+
+    def disturbance_range(self, state):
+        return []
+
+    def clamp_control(self, state, control):
+        return torch.clamp(control, -self.omega_max, self.omega_max)
+
+    def clamp_disturbance(self, state, disturbance):
+        return disturbance
+
+    def bound_disturbance(self, disturbance):
+        return disturbance
+
+    def state_test_range(self):
+        return self.state_range_.cpu().tolist()
+
+    def state_verification_range(self):
+        # scenario_optimization() samples through this; without it the recovery /
+        # post-hoc-certification evaluation dies with AttributeError, which is why
+        # every high-dim recovery run produced no basic_logs. Same convention the
+        # shipped classes use: verify over the training range.
+        return self.state_range_.cpu().tolist()
+
+    def equivalent_wrapped_state(self, state):
+        w = torch.clone(state)
+        for i in (6, 7, 8):
+            w[..., i] = (w[..., i] + math.pi) % (2 * math.pi) - math.pi
+        return w
+
+    def periodic_transform_fn(self, input):
+        return input.to(device)
+
+    def dsdt(self, state, control, disturbance):
+        out = torch.zeros_like(state)
+        out[..., 0] = self.velocity * torch.cos(state[..., 6])
+        out[..., 1] = self.velocity * torch.sin(state[..., 6])
+        out[..., 2] = self.velocity * torch.cos(state[..., 7])
+        out[..., 3] = self.velocity * torch.sin(state[..., 7])
+        out[..., 4] = self.velocity * torch.cos(state[..., 8])
+        out[..., 5] = self.velocity * torch.sin(state[..., 8])
+        out[..., 6] = control[..., 0]
+        out[..., 7] = control[..., 1]
+        out[..., 8] = control[..., 2]
+        return out
+
+    def boundary_fn(self, state):
+        # min over the three pairwise distances (1-2, 1-3, 2-3) minus R.
+        d12 = torch.norm(state[..., 0:2] - state[..., 2:4], dim=-1)
+        d13 = torch.norm(state[..., 0:2] - state[..., 4:6], dim=-1)
+        d23 = torch.norm(state[..., 2:4] - state[..., 4:6], dim=-1)
+        return torch.min(torch.min(d12, d13), d23) - self.collisionR
+
+    def cost_fn(self, state_traj):
+        return torch.min(self.boundary_fn(state_traj), dim=-1).values
+
+    def sample_target_state(self, num_samples):
+        raise NotImplementedError
+
+    def hamiltonian(self, state, dvds):
+        ham = (self.velocity * (torch.cos(state[..., 6]) * dvds[..., 0]
+                                + torch.sin(state[..., 6]) * dvds[..., 1])
+               + self.omega_max * torch.abs(dvds[..., 6]))
+        ham = ham + (self.velocity * (torch.cos(state[..., 7]) * dvds[..., 2]
+                                      + torch.sin(state[..., 7]) * dvds[..., 3])
+                     + self.omega_max * torch.abs(dvds[..., 7]))
+        ham = ham + (self.velocity * (torch.cos(state[..., 8]) * dvds[..., 4]
+                                      + torch.sin(state[..., 8]) * dvds[..., 5])
+                     + self.omega_max * torch.abs(dvds[..., 8]))
+        if self.set_mode == "avoid":
+            return ham
+        raise NotImplementedError("MultiVehicle9D is an avoid benchmark")
+
+    def optimal_control(self, state, dvds):
+        return self.omega_max * torch.sign(dvds[..., [6, 7, 8]])
+
+    def optimal_disturbance(self, state, dvds):
+        return torch.zeros(1).to(device)
+
+    def plot_config(self):
+        return {
+            "state_slices": [0.0, 0.0, -0.4, 0.0, 0.4, 0.0,
+                             math.pi / 2, -math.pi / 2, math.pi / 2],
+            "state_labels": ["x1", "y1", "x2", "y2", "x3", "y3",
+                             "th1", "th2", "th3"],
+            "x_axis_idx": 0, "y_axis_idx": 1, "z_axis_idx": 6,
+        }
+
